# Copy these into your local .env file or set them in Render's Environment tab.
# For Gmail SMTP, use smtp.gmail.com, port 465, secure true, and an App Password.
# Keep SMTP_PASS private; never commit it to GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
MAIL_FROM=
